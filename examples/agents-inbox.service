# Install: copy to ~/.config/systemd/user/agents-inbox.service, then
#   systemctl --user daemon-reload
#   systemctl --user enable --now agents-inbox
[Unit]
Description=agents-inbox: question queue for the owner

[Service]
ExecStart=%h/.local/bin/agents-inbox
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
