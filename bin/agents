LANG = pick_lang(STRINGS)
TEXT = strings_for(STRINGS, LANG)


def t(key, **vars):
    return TEXT.get(key, key).format(**vars)


DOC_RU = """agents - живые сессии Claude Code на этой машине: статус, сообщения, up/down.

  agents status [--json [--max-age S]]
