                                  --remote-control Duty "start the shift").

Навіщо стискати перед закриттям: кеш промпту живе годину від останнього запиту.
Сесія, відновлена пізніше, знову пише весь контекст у кеш за повною ціною;
стиснута — лише короткий підсумок. Стиснення за простоєм живе в claude-cache-keeper.

Люди: ~/.config/agents/people.conf, "ім'я сесії | ім'я для показу | f|m|-|x"
  (x = сховати сесію, наприклад вікно-дашборд).
Знімок чек-листа: ~/.local/state/agents/checklist/items/*.json, по JSON на пункт
  ({id, data: {project, title, who, status, ...}}), як пише вивантаження бази
  артефакту; "чекає на тебе" = відкриті пункти, у яких `who` з OWNER_WHO.
Лог: ~/.local/state/agents/compact.log
Оточення: MIN_CTX (токени; down не стискає менший контекст).
Мова: AGENTS_LANG=en|ru|uk, інакше за LC_ALL / LC_MESSAGES / LANG.
"""

DOCS = {"en": __doc__, "ru": DOC_RU, "uk": DOC_UK}


# "shell": the turn is over but a background command (Monitor, a server) runs.
# The session takes input like an idle one.
IDLE_STATES = ("idle", "shell")


def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    line = f"{datetime.now().isoformat(timespec='seconds')} {msg}"
    with open(LOG, "a") as f:
        f.write(line + "\n")
    print(line)


def do_compact(s):
    why = None
    if not s["target"]:
        why = t("not_in_tmux")
    elif s["status"] not in IDLE_STATES:
        why = t("status_is", status=s["status"])
    elif not input_empty(s["target"]):
        why = t("draft")
    if why:
        log(f"skip  {s['name']}: {why}")
        return False
    tmux("send-keys", "-t", s["target"], "-l", "/compact")
    time.sleep(0.5)
    tmux("send-keys", "-t", s["target"], "Enter")
    log(f"sent  {s['name']}: " + t("sent_compact", k=s["ctx"]//1000, idle=s["idle"], label=s["label"]))
    return True


def cmd_status():
    print(f"{t('h_session'):28} {t('h_status'):7} {t('h_idle'):>8} {t('h_cache'):>7} {t('h_context'):>9}  {t('h_model')}")
    for s in sessions():
        idle = f"{s['idle']:.0f}{t('unit_m')}" if s["idle"] is not None else "—"
        if s["idle"] is None:
            cache = "—"
        else:
            left = CACHE_TTL - s["idle"]
            cache = f"{left:.0f}{t('unit_m')}" if left > 0 else t("expired")
        ctx = f"{s['ctx']//1000}k" if s["ctx"] else t("compact")
        status = TEXT.get("st_" + s["status"], s["status"])
        model = s["model"].replace("claude-", "")
        print(f"{s['name'][:28]:28} {status:7} {idle:>8} {cache:>7} {ctx:>9}  {model} / {s['label'] or t('no_tmux')}")


def people():
    out = {}
    for parts in conf_lines(PEOPLE_CONF):
        parts += ["", ""]
        out[parts[0]] = {"display": parts[1] or parts[0], "gender": parts[2] or "-"}
    return out


def checklist():
    files = glob.glob(os.path.join(CHECKLIST_DIR, "*.json"))
    if not files:
        return None
    items = []
    for f in files:
        try:
            d = json.load(open(f))
        except Exception:
            continue
        data = d.get("data") or d
        if data.get("status") not in ("todo", None):
            continue
        items.append({"id": d.get("id") or os.path.basename(f)[:-5],
                      "project": data.get("project", ""), "title": data.get("title", ""),
                      "who": data.get("who", ""), "section": data.get("section", ""),
                      "order": data.get("order", 0)})
    items.sort(key=lambda i: (i["project"], i["order"]))
    waiting = [i for i in items if i["who"] in OWNER_WHO]
    projects = {}
    for f in files:
        try:
            d = json.load(open(f))
        except Exception:
            continue
        data = d.get("data") or d
        p = projects.setdefault(data.get("project") or "?", {"todo": 0, "later": 0, "done": 0, "waiting": 0})
        st = data.get("status") or "todo"
        p[st] = p.get(st, 0) + 1
        if st == "todo" and data.get("who") in OWNER_WHO:
            p["waiting"] += 1
    return {"snapshot": max(os.path.getmtime(f) for f in files),
            "open": len(items), "waiting": waiting, "items": items,
            "projects": [{"name": k, **v} for k, v in
                         sorted(projects.items(), key=lambda kv: (-kv[1]["waiting"], -kv[1]["todo"], kv[0]))]}


def inbox():
    """{"open": N} open questions, or None when the inbox is not set up
    (no inbox.conf). Read-only, gives up after half a second on a locked db."""
    import sqlite3
    from urllib.parse import quote
    from agents_inbox import config as inbox_config
    path = inbox_config.default_path()
    if not os.path.exists(path):
        return None
    try:
        db = inbox_config.db_path(inbox_config.load(path))
        if not os.path.exists(db):
            return {"open": 0}
        c = sqlite3.connect(f"file:{quote(db)}?mode=ro", uri=True, timeout=0.5)
        try:
            n = c.execute("SELECT COUNT(*) FROM questions WHERE status='open'").fetchone()[0]
        finally:
            c.close()
    except Exception:
        n = 0
    return {"open": n}


def project_of(s):
    if s["label"]:
        return s["label"].split(":", 1)[0]
    return os.path.basename(s["cwd"].rstrip("/")) or "?"


def transcript_tail(sid):
    paths = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{sid}.jsonl"))
    if not paths:
        return []
    with open(paths[0], "rb") as f:
        f.seek(max(0, os.path.getsize(paths[0]) - TAIL_BYTES))
        return f.read().decode("utf-8", "replace").splitlines()


def ts_of(d):
    return datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00"))


def messages(hours=6, live=None):
    """SendMessage calls of live sessions: newest first, with cold-wake marks."""
    live = live if live is not None else sessions()
    by_pid = {s["pid"]: s for s in live}
    by_name = {s["name"]: s for s in live}
    since = datetime.now(timezone.utc).timestamp() - hours * 3600
    replies = {}      # sid -> sorted timestamps of the session's own replies
    out = []
    for s in live:
        own = []
        for line in transcript_tail(s["sid"]):
            if '"type":"assistant"' not in line:
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("isSidechain"):
                continue
            t = ts_of(d).timestamp()
            own.append(t)
            if t < since or '"SendMessage"' not in line:
                continue
            for c in (d.get("message") or {}).get("content") or []:
                if not (isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") == "SendMessage"):
                    continue
                inp = c.get("input") or {}
                to = str(inp.get("to", ""))
                m = re.search(r"/(\d+)\.sock$", to)
                target = by_pid.get(int(m.group(1))) if m else by_name.get(to)
                text = inp.get("summary") or str(inp.get("message", "")).split("\n")[0]
                to_name = target["name"] if target else ("(closed session)" if m else to)
                out.append({"ts": t, "from": s["name"], "to": to_name,
                            "to_sid": target["sid"] if target else None, "text": text[:160]})
        replies[s["sid"]] = sorted(own)
    for m in out:
        own = replies.get(m.pop("to_sid"), [])
        before = [t for t in own if t <= m["ts"]]
        m["cold"] = bool(before) and (m["ts"] - before[-1]) / 60 > CACHE_TTL
    out.sort(key=lambda m: m["ts"], reverse=True)
    return out


def cmd_messages(hours):
    for m in messages(hours):
        when = datetime.fromtimestamp(m["ts"]).strftime("%H:%M")
        to = t("closed_session") if m["to"] == "(closed session)" else m["to"]   # the JSON keeps the English marker
        print(f"{when} {'❄' if m['cold'] else ' '} {m['from'][:22]:22} → {to[:22]:22} {m['text'][:90]}")


def cmd_status_json(max_age):
    if max_age:
        try:
            if time.time() - os.path.getmtime(STATUS_CACHE) < max_age:
                sys.stdout.write(open(STATUS_CACHE).read())
                return
        except OSError:
            pass
    ppl = people()
    now = datetime.now(timezone.utc)
    rows = []
    live = sessions()
    for s in live:
        p = ppl.get(s["name"], {})
        rows.append({
            "name": s["name"], "display": p.get("display", s["name"]),
            "gender": p.get("gender", "-"), "project": project_of(s),
            "status": s["status"], "model": s["model"].replace("claude-", ""),
            "idle_min": None if s["idle"] is None else round(s["idle"], 1),
            "cache_min": None if s["idle"] is None else round(CACHE_TTL - s["idle"], 1),
            "ctx": s["ctx"], "tmux": s["label"], "target": s["target"], "pid": s["pid"],
            "tool": s["tool"], "tool_hint": s.get("tool_hint", "")})
    ppl_display = {k: v["display"] for k, v in ppl.items()}
    msgs = [{**m, "from": ppl_display.get(m["from"], m["from"]), "to": ppl_display.get(m["to"], m["to"])}
            for m in messages(6, live)[:12]]
    out = json.dumps({"at": now.isoformat(timespec="seconds"), "sessions": rows,
                      "checklist": checklist(), "messages": msgs, "inbox": inbox()},
                     ensure_ascii=False)
    os.makedirs(os.path.dirname(STATUS_CACHE), exist_ok=True)
    tmp = STATUS_CACHE + f".{os.getpid()}"
    try:
        with open(tmp, "w") as f:
            f.write(out)
        os.replace(tmp, STATUS_CACHE)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    sweep_status_tmp()
    sys.stdout.write(out)


def sweep_status_tmp():
    """Remove status.json.<pid> left by writers that were killed mid-write
    (e.g. by the panel's timeout): their pid is gone."""
    for path in glob.glob(STATUS_CACHE + ".*"):
        pid = path.rsplit(".", 1)[1]
        if not pid.isdigit() or os.path.exists(f"/proc/{pid}"):
            continue
        try:
            os.unlink(path)
        except OSError:
            pass


def boundary_after(sid, since):
    """Is there a compact_boundary in the transcript newer than since (unix time)."""
    paths = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{sid}.jsonl"))
    if not paths:
        return False
    with open(paths[0], "rb") as f:
        f.seek(max(0, os.path.getsize(paths[0]) - TAIL_BYTES))
        for line in reversed(f.read().decode("utf-8", "replace").splitlines()):
            if '"compact_boundary"' in line:
                try:
                    ts = json.loads(line)["timestamp"].replace("Z", "+00:00")
                    return datetime.fromisoformat(ts).timestamp() > since
                except Exception:
                    return False
    return False


def compact_wait(s):
    """Compact a session and wait until done. True = compacted or nothing to do."""
    since = time.time() - 1

    # "Not enough messages" never reaches the transcript - count it on screen
    def nothing_to_do():
        if not s["target"]:
            return 0
        return tmux("capture-pane", "-p", "-S", "-200", "-t", s["target"]).count(
            "Not enough messages to compact")
    before = nothing_to_do()
    if not do_compact(s):
        return False
    # Done = a new compact_boundary in the transcript. The screen is no
    # proof: an old "Compacted" line from a previous run may still be
    # visible there (that once got a session restarted mid-compaction).
    for _ in range(120):
        if boundary_after(s["sid"], since):
            log(f"done  {s['name']}: " + t("done_compacted"))
            return True
        if nothing_to_do() > before:
            log(f"done  {s['name']}: " + t("done_nothing"))
            return True
        time.sleep(5)
    log(f"FAIL  {s['name']}: " + t("fail_compact"))
    return False


def cmd_compact(name, wait):
    for s in sessions():
        if s["name"] == name:
            return compact_wait(s) if wait else do_compact(s)
    print(t("no_session", name=name))
    return False


def split_comment(line):
    """(body, comment): a comment starts at '#' outside quotes that opens the
    line or follows whitespace, so `"fix issue #5"` and `a#b` stay intact."""
    quote = None
    for i, ch in enumerate(line):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "'\"":
            quote = ch
        elif ch == "#" and (i == 0 or line[i - 1].isspace()):
            return line[:i], line[i:]
    return line, ""


def find_session(name):
    for s in sessions():
        if s["name"] == name:
            return s
    return None


def ready_for_clear(s):
    # Only "idle": "shell" means a background command (a Monitor, a wait for a
    # deploy) is still running for the current task - clearing it loses the task.
    return bool(s["target"]) and s["status"] == "idle" and input_empty(s["target"])


def cmd_clear(name, timeout_min):
    """Wait until the session is idle with an empty input box, then /clear it.

    A background command ("shell") counts as busy. Two idle checks 10 s
    apart: a session that has just finished a turn often
    starts another one right away (a queued message, a background task).
    Done = the session id changed: /clear starts a new transcript.
    """
    s = find_session(name)
    if not s:
        print(t("no_session", name=name))
        return False
    if not s["target"]:
        log(f"skip  {name}: " + t("not_in_tmux"))
        return False
    deadline = time.time() + timeout_min * 60
    ready, told = 0, False
    while True:
        s = find_session(name)
        if not s:
            print(t("no_session", name=name))
            return False
        ready = ready + 1 if ready_for_clear(s) else 0
        if ready >= 2:
            break
        if time.time() > deadline:
            log(f"skip  {name}: " + t("clear_timeout", min=timeout_min))
            return False
        if not ready and not told:
            log(f"wait  {name}: " + t("clear_waiting", min=timeout_min))
            told = True
        time.sleep(10)
    old_sid = s["sid"]
    tmux("send-keys", "-t", s["target"], "-l", "/clear")
    time.sleep(0.5)
    tmux("send-keys", "-t", s["target"], "Enter")
    log(f"sent  {name}: " + t("sent_clear", k=s["ctx"]//1000, label=s["label"]))
    for _ in range(15):
        time.sleep(2)
        s = find_session(name)
        if s and s["sid"] and s["sid"] != old_sid:
            log(f"done  {name}: " + t("done_cleared", sid=s["sid"]))
            return True
    log(f"FAIL  {name}: " + t("clear_unconfirmed"))
    return False


def conf_lines(path):
    if not os.path.exists(path):
        return []
    out = []
    for line in open(path):
        line = split_comment(line)[0].strip()
        if line:
            out.append([p.strip() for p in line.split("|")])
    return out


def team_project(name):
    for parts in conf_lines(CONF):
        if parts[0] == name and len(parts) >= 4:
            return parts
    return None


def session_lines(name, names):
    rows = [p + [""] * (6 - len(p)) for p in conf_lines(SESS_CONF) if p[0] == name]
    if names:
        rows = [r for r in rows if r[1] in names]
    return rows


def save_session_id(project, name, sid):
    lines = open(SESS_CONF).read().splitlines(keepends=True)
    for i, line in enumerate(lines):
        body, comment = split_comment(line.rstrip("\n"))
        parts = [p.strip() for p in body.split("|")]
        if len(parts) >= 2 and parts[0] == project and parts[1] == name:
            parts += [""] * (6 - len(parts))
            parts[4] = sid
            # keep a trailing comment and everything after the 6th column
            new = " | ".join(parts[:5] + (["|".join(parts[5:]).strip()] if any(parts[5:]) else []))
            lines[i] = new + (" " + comment if comment else "") + "\n"
    with open(SESS_CONF, "w") as f:
        f.writelines(lines)


def live_by_row(project, rows):
    """Live session per config row: by id, else by name and directory.

    /clear starts a new session id inside the same process, so the id in the
    config goes stale. The name (claude -n) and cwd still match; when they do,
    the new id is written back to the config.
    """
    live = sessions()
    by_sid = {s["sid"]: s for s in live}
    found = {}
    for r in rows:
        name, d, sid = r[1], os.path.realpath(os.path.expanduser(r[2])), r[4]
        s = by_sid.get(sid) if sid else None
        if s is None:
            same = [x for x in live if x["name"] == name and os.path.realpath(x["cwd"]) == d]
            if len(same) == 1:
                s = same[0]
                if s["sid"] and s["sid"] != sid:
                    save_session_id(project, name, s["sid"])
                    r[4] = s["sid"]
        if s is not None:
            found[name] = s
    return found


def sessions_up(project, rows, fresh=False):
    running = live_by_row(project, rows)
    live = {s["sid"]: s for s in running.values()}
    for _, name, d, model, sid, extra in rows:
        if fresh and sid in live:
            print(f"  = {name}: " + t("running_first", project=project))
            continue
        if fresh:
            sid = ""
        if sid and sid in live:
            s = live[sid]
            print(f"  = {name}: " + t("already_running", pid=s["pid"], where=s["label"] or t("no_tmux")))
            continue
        args = ["claude", "-n", name]
        if model and model != "-":
            args += ["--model", model]
        if sid:
            args += ["--resume", sid]
        else:
            sid = str(uuid.uuid4())
            args += ["--session-id", sid]
            save_session_id(project, name, sid)
        if extra:
            args += shlex.split(extra)
        # A tmux server keeps the environment it was started with; drop
        # CLAUDE* so the new session does not think it runs inside another one.
        cmd = "for v in ${!CLAUDE@}; do unset $v; done; exec " + " ".join(shlex.quote(a) for a in args)
        d = os.path.expanduser(d)
        if subprocess.run(["tmux", "has-session", "-t", f"={project}"], capture_output=True).returncode:
            tmux("new-session", "-d", "-s", project, "-n", name, "-c", d, "bash", "-c", cmd)
        else:
            tmux("new-window", "-d", "-t", f"={project}:", "-n", name, "-c", d, "bash", "-c", cmd)
        print(f"  + {name}: " + t("started", project=project, name=name,
                              how=t("how_resume", sid=sid) if "--resume" in args else t("how_new", sid=sid)))
    return 0


def sessions_down(project, rows, compact=True):
    rc = 0
    for s in live_by_row(project, rows).values():
        if not s["target"]:
            print(f"  ! {s['name']}: " + t("close_yourself"))
            rc = 1
            continue
        if compact and s["ctx"] >= MIN_CTX and not compact_wait(s):
            print(f"  ! {s['name']}: " + t("not_closed"))
            rc = 1
            continue
        if not type_command(s, "/exit"):
            rc = 1
            continue
        for _ in range(30):
            if not os.path.exists(f"/proc/{s['pid']}"):
                break
            # background tasks still running: Claude asks before exiting; the
            # tasks belong to the session we are closing, so stop them too
            screen = tmux("capture-pane", "-p", "-t", s["target"])
            if "Background work is running" in screen and "Exit and stop tasks" in screen:
                tmux("send-keys", "-t", s["target"], "Enter")
            time.sleep(1)
        if os.path.exists(f"/proc/{s['pid']}"):
            print(f"  ! {s['name']}: " + t("still_running", pid=s["pid"]))
            rc = 1
            continue
        print(f"  - {s['name']}: " + t("closed_cold", sid=s["sid"]))
    return rc


def type_command(s, text):
    """Type a command into an idle session with an empty input box."""
    if s["status"] not in IDLE_STATES or not input_empty(s["target"]):
        print(f"  ! {s['name']}: " + t("busy_skipped"))
        return False
    tmux("send-keys", "-t", s["target"], "-l", text)
    time.sleep(0.5)
    tmux("send-keys", "-t", s["target"], "Enter")
    return True


def cmd_updown(which, name, names):
    team = team_project(name)
    if team:
        _, d, up, down = team[:4]
        cmd = up if which == "up" else down
        env = {k: v for k, v in os.environ.items() if not k.startswith("CLAUDE")}
        return subprocess.run(["bash", "-c", f'{cmd} "$@"', "_", *names],
                              cwd=os.path.expanduser(d), env=env).returncode
    fresh = "--fresh" in names
    compact = "--no-compact" not in names
    names = [n for n in names if n not in ("--fresh", "--no-compact")]
    rows = session_lines(name, names)
    if not rows:
        sys.exit(t("no_project", name=name, conf=CONF, sess=SESS_CONF))
    return sessions_up(name, rows, fresh) if which == "up" else sessions_down(name, rows, compact)


def opt_number(argv, opt, default):
    if opt not in argv:
        return default
    i = argv.index(opt)
    try:
        return float(argv[i + 1])
    except (IndexError, ValueError):
        sys.exit(t("bad_number", opt=opt))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(DOCS.get(LANG, __doc__)); return 0
    c = argv[0]
    if c in ("ask", "inbox"):
        from agents_inbox import cli
        return cli.main(argv)
    if c == "status" and "--json" in argv:
        cmd_status_json(opt_number(argv, "--max-age", 0))
    elif c == "status":
        cmd_status()
    elif c == "messages":
        cmd_messages(opt_number(argv, "--hours", 6))
    elif c == "compact" and len(argv) >= 2:
        return 0 if cmd_compact(argv[1], "--wait" in argv) else 1
    elif c == "clear" and len(argv) >= 2:
        return 0 if cmd_clear(argv[1], opt_number(argv, "--timeout", 30)) else 1
    elif c in ("up", "down") and len(argv) >= 2:
        return cmd_updown(c, argv[1], argv[2:])
    else:
        print(DOCS.get(LANG, __doc__)); return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
